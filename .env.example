# Copy this file to .env and adjust. Real environment variables override .env.
# Never put secrets in files you commit; .env is ignored by git.

ASSISTANT_NAME=Jarvis
# How the assistant addresses you (e.g. sir, or your name). Empty = no honorific.
USER_ADDRESS=
# Your name, shown on the start screen (empty = THIS PC)
USER_NAME=

# --- AI ---------------------------------------------------------------------
AI_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
# Leave empty to pick from the models installed in Ollama.
AI_MODEL=
# Start the installed Ollama app automatically if Jarvis can't reach it (only for Ollama on this PC)
AUTO_START_OLLAMA=true
# At start-up, minimise the window the Ollama app opens (Ollama keeps running) and bring Jarvis to the front
HIDE_OLLAMA_WINDOW=true
# true: a restart/shutdown always shows the confirmation dialog. false: "restart / shut down my PC" that you say or
# type yourself runs after a 10-second countdown (say "cancel" or press Esc to stop it). When the AI decides on its
# own (for example because of something on a web page), it ALWAYS asks, whatever this says.
CONFIRM_POWER_ACTIONS=true
# Before a restart/shutdown, press Ctrl+S in every window whose title shows unsaved changes (VS Code, Notepad...)
SAVE_BEFORE_POWER=true
AI_REQUEST_TIMEOUT=120
AI_TEMPERATURE=0.3
# Context window sent to Ollama (tokens). Larger = more memory/VRAM.
AI_CONTEXT_WINDOW=8192
# Let reasoning ("thinking") models think before answering. Slower; off suits voice.
# true = allow switching to another installed model when YOUR benchmark results (python run.py --quality) show the
# current one obeyed hidden instructions in web/email text, or its tool calls keep failing. Never guesses; off by default
AI_AUTO_SWITCH=false
TAINT_LOCKDOWN=false
# How much Jarvis may do on its own: observe (only reads) | suggest (plans, does nothing) | routine (default) | approval (everything that changes asks)
AUTONOMY=routine
# Full power: nothing is off-limits. Actions that are normally refused (CRITICAL) ask you in an on-screen dialog
# instead - never by voice, from a phone, by a standing approval or in an automation.
FULL_POWER=false
# Phone requests use the stricter of AUTONOMY and AUTONOMY_REMOTE (observe | suggest | routine | approval)
AUTONOMY_REMOTE=routine
# Tool categories that always ask / are switched off, comma-separated (e.g. files, phone, home, apps, dev, office, system)
AUTONOMY_ASK_CATEGORIES=
AUTONOMY_BLOCK_CATEGORIES=
# Voice finish: natural (human, professional) or classic (the older synthetic edge)
TTS_STYLE=natural
# The 3D core: CORE_RENDERER=auto|gl|painter, VISUAL_QUALITY=auto|low|balanced|high
CORE_RENDERER=auto
VISUAL_QUALITY=auto
CORE_SPEED=1.0
GLOW_INTENSITY=1.0
REDUCED_MOTION=false
# Flat rings / gauges / tick bezel around the 3D core (gold segments, CPU/battery arcs)
CORE_HUD_RINGS=false
# Clipboard memory: keep text you copy so you can say "paste what I copied about X". Off by default. Passwords, keys and
# card numbers are never kept; items expire after CLIPBOARD_RETENTION_DAYS (1-90) unless pinned; erase with "clear my clipboard history"
CLIPBOARD_HISTORY=false
CLIPBOARD_RETENTION_DAYS=7
AI_THINK=false
# How long Ollama keeps the model loaded after a request (0 = unload, -1 = forever)
OLLAMA_KEEP_ALIVE=30m
# Short-term conversation memory limits
CONTEXT_MAX_MESSAGES=24
CONTEXT_MAX_CHARS=16000

# --- Voice input --------------------------------------------------------------
WAKE_WORD=hey jarvis
# Always listen for the wake phrase, so you never press Talk. The microphone stays open; audio is checked
# locally for the wake phrase only and nothing is recorded until you say it.
HANDS_FREE=false
# auto (a wake-word model for "hey jarvis", else whisper), openwakeword, whisper (transcribes every utterance: more CPU)
WAKE_WORD_ENGINE=auto
# 0.1-0.95: lower reacts more easily (and to more false alarms)
WAKE_WORD_THRESHOLD=0.5
# Also wake on just the name ("Jarvis", "Jarvis, are you there?"): short sentences are transcribed on this PC
# and checked for the name; anything else is dropped (never shown, logged or stored). Uses a little more CPU.
WAKE_ON_NAME=true
# Absolute path to a custom openWakeWord .onnx model for a different wake phrase (empty = built-in "hey jarvis")
# Optional phone push wake-ups (FCM). Absolute path of the service-account .json from YOUR Firebase project
# (Project settings > Service accounts > Generate new private key). Only a content-free "sync" ping is sent; see docs/STATUS.md.
# The bundled Android app polls and cannot receive FCM: this needs a Firebase-enabled build. Empty = off
FCM_SERVICE_ACCOUNT=
WAKE_WORD_MODEL=
# Once woken ("Jarvis" / "Hey Jarvis"), keep the conversation going without the wake phrase until it has heard
# no request for this many seconds (time only counts while it listens, not while it talks). Say "goodbye" or
# "that's all" to end sooner. 0 = say the wake phrase every time.
FOLLOW_UP_SECONDS=20
# Short chime when the wake phrase is heard
WAKE_SOUND=true
# en, bn, hi, ... or auto. Non-English needs a multilingual STT_MODEL (no ".en").
VOICE_LANGUAGE=en
# with VOICE_LANGUAGE=auto: the languages you speak, detected automatically (e.g. en,bn for Bangla + English)
VOICE_LANGUAGES=en,bn
MICROPHONE_ENABLED=true
# Device index or part of its name (see: python run.py --devices). Empty = Windows default.
MICROPHONE_DEVICE=
# auto = large-v3-turbo on an NVIDIA GPU, else small.en on the CPU (falls back automatically).
# Or pick one: tiny.en, base.en, small.en, medium.en, small, medium, large-v3-turbo ...
STT_MODEL=auto
# auto, cpu, or cuda (NVIDIA GPU; the libraries come from: pip install -r requirements-gpu.txt)
STT_DEVICE=auto
# auto = float16 on the GPU, int8 on the CPU
STT_COMPUTE_TYPE=auto
STT_BEAM_SIZE=5
# Names and words you use often (comma-separated), e.g. Arijit Singh, Rafi, DIU. Your corrections are added too.
CUSTOM_VOCABULARY=
# Unsure of a sentence: recognise it again more carefully (GPU) before asking you to repeat
STT_SECOND_PASS=true
# GPU: start recognizing at your first short pause, so the answer comes sooner (if you keep talking, it waits)
EARLY_TRANSCRIPTION=true
# Optional: a Whisper model fine-tuned for Bangla, in CTranslate2 format (a folder, or a Hugging Face repo).
# Bangla sentences are recognised again with it. See README: Bangla speech model. Empty = off
STT_BANGLA_MODEL=
# After Menu -> Teach me my wake word: wake-ups that don't sound like your recordings are ignored
PERSONAL_WAKE_CHECK=true
# Transcripts below this confidence (0-1) are not acted on
STT_MIN_CONFIDENCE=0.35
# auto (neural Silero speech detection: reliable end of speech in noisy rooms), silero, energy
VAD_ENGINE=auto
# Seconds of silence that end an utterance
SILENCE_TIMEOUT=0.9
SPEECH_START_TIMEOUT=6
MAX_RECORD_SECONDS=15

# --- Voice output -------------------------------------------------------------
TTS_ENABLED=true
# auto (Piper if downloaded, else Windows voice), piper, sapi, or neural: natural online Bangla + English
# voices (the reply text is sent to Microsoft's speech service; offline it falls back to Piper/Windows)
# jarvis = the JARVIS voice: British neural voice (en-GB-RyanNeural), calmer and deeper, with a subtle AI finish;
# offline it uses Kokoro (bm_george) or the Windows voice. Bangla replies use TTS_NEURAL_VOICE_BN.
TTS_ENGINE=jarvis
TTS_NEURAL_VOICE_EN=en-GB-RyanNeural
TTS_NEURAL_VOICE_BN=bn-BD-PradeepNeural
# Offline natural English voice for TTS_ENGINE=kokoro (downloads 120 MB once): bm_george, am_michael, af_heart,
# bf_emma ... With the neural voice, Kokoro is used when the internet is down (once downloaded)
TTS_KOKORO_VOICE=bm_george
TTS_VOICE=en_US-lessac-medium
# Part of a Windows voice name, e.g. Zira or David. Empty = default voice.
TTS_SAPI_VOICE=
TTS_SPEED=1.0
TTS_VOLUME=1.0
OUTPUT_DEVICE=

# --- Desktop app ------------------------------------------------------------
# "open X" / "close X" for known apps run directly, without asking the AI model (faster, more reliable)
DIRECT_COMMANDS=true
START_MINIMIZED=false
# Start automatically when you sign in to Windows (needed for scheduled tasks to run)
START_WITH_WINDOWS=false
# Speak answers to typed messages too (voice questions are always answered aloud)
SPEAK_TYPED_REPLIES=false
# Under answers that used tools or saved memories: a line saying where the facts came from
SHOW_SOURCES=true
# Learn from every request's real outcome (skills that worked, lessons from your corrections). Local only.
LEARN_FROM_USE=true
# Seconds between CPU/RAM/battery updates in the window
MONITOR_INTERVAL=3
# A light history of CPU / memory / disk / battery (one reading a minute, kept 14 days): trends and alerts
METRICS_HISTORY=true
# How many days of CPU / memory / disk / battery readings to keep (1-90)
METRICS_RETENTION_DAYS=14
# OFF by default. When on, the five busiest programs' names (never command lines or window titles) are recorded
# with CPU / memory numbers once a minute, for "this program uses more than usual" and crash correlation
PROCESS_HISTORY=false
# Forget what Jarvis recorded by itself (e.g. "mission finished") after this many days; 0 keeps it
MEMORY_EVENT_RETENTION_DAYS=0
# A verified copy of the database once a day in data\backups (newest 7 kept)
AUTO_BACKUP=true

# --- General ----------------------------------------------------------------
# auto = online; internet features pause by themselves only while the connection is down, and come back
# when it returns. on = always offline (nothing goes to the internet). off = never check the connection.
OFFLINE_MODE=auto
DEBUG=false
LOG_LEVEL=INFO
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
# Optional absolute folder for the database and logs (default: .\data)
JARVIS_DATA_DIR=

# --- Developer tools --------------------------------------------------------------
# Default project for "git status", "run my tests" ... (absolute path, e.g. D:\Jarvis)
DEV_PROJECT_DIR=
# Seconds before a foreground command is stopped
DEV_COMMAND_TIMEOUT=120

# --- Browser automation -----------------------------------------------------------
BROWSER_ENABLED=true
# The installed browser the assistant drives in its own separate profile: msedge (built into Windows), chrome,
# or chromium (run "python -m playwright install chromium" first)
BROWSER_CHANNEL=msedge
BROWSER_HEADLESS=false
BROWSER_IDLE_MINUTES=10
SEARCH_PROVIDER=duckduckgo
# Which profile "open Chrome" / "open Edge" opens, so you skip "Who's using Chrome?":
# last = the profile you used last, none = show the picker, or a profile name / account name / "Profile 3".
# See your profiles with: python run.py --browser-profiles
CHROME_PROFILE=last
# Where websites open when no app is installed for them: default (the Windows default browser), chrome, edge, firefox
WEB_BROWSER=default
EDGE_PROFILE=last

# --- Screen (opt-in) --------------------------------------------------------------
# Allow the assistant to take screenshots, read the text on screen and describe it. Off until you turn it on.
SCREEN_CAPTURE_ENABLED=false
# Context engine: read the title of the window you work in (app, project, file) - never the screen. Off in Private mode.
CONTEXT_WINDOW_TITLES=true
# Where take_screenshot saves PNG files (empty = Pictures\Screenshots\<assistant name>)
SCREENSHOT_DIR=
# Windows whose title or program contains one of these words are never captured
SCREEN_BLOCKED_WINDOWS=password, keepass, 1password, bitwarden, lastpass, dashlane, nordpass, proton pass, credential manager, authenticator, inprivate
# Text recognition: auto (Windows OCR, then Tesseract), windows, tesseract
OCR_ENGINE=auto
# Empty = your Windows languages; e.g. en-US, bn (Tesseract codes such as eng+ben also work)
OCR_LANGUAGE=
# Ollama model that can see images, for "what's on my screen" (empty = pick one, e.g. after 'ollama pull qwen2.5vl:3b')
VISION_MODEL=

# --- Smart home (optional) ---------------------------------------------------
# Home Assistant address, e.g. http://192.168.1.10:8123 (empty = smart home off)
HOME_ASSISTANT_URL=
# Long-lived access token (Home Assistant -> Profile -> Security). Kept on this PC, never logged.
HOME_ASSISTANT_TOKEN=
# GitHub (read-only: notifications, assigned issues/PRs, a repo's open PRs). A fine-grained read-only token is enough
GITHUB_TOKEN=
# Google Calendar / Drive: create your OWN OAuth client (Google Cloud Console -> Credentials -> OAuth client ID -> "Desktop app"),
# paste its ID and secret here, then say "connect Google". Jarvis asks only for: calendar events and Drive file names (read-only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Assistant --------------------------------------------------------------
# Your city, for "what's the weather" and "good morning" (e.g. Dhaka or Dhaka, Bangladesh)
HOME_LOCATION=
TEMPERATURE_UNIT=celsius
# Country for the news headlines (two letters: BD, IN, US, GB ...)
NEWS_REGION=BD
# What "play some music" plays when you don't name a song (a YouTube search)
MUSIC_DEFAULT_QUERY=top hits playlist
# Speak up on its own: low battery, charger plugged in/out
PROACTIVE_ALERTS=true
# Warn about a nearly full disk, an app hogging the CPU, a hot GPU, and finished big downloads
PC_WATCHER=true
LOW_BATTERY_PERCENT=20
# "Hey Jarvis" while it is speaking stops the speech and listens
BARGE_IN=true

# --- Voice safety -------------------------------------------------------------
# Talk over Jarvis while it speaks: "stop", or a new command (needs speech recognition on a GPU)
VOICE_INTERRUPT=true
# Answer its questions out loud: "yes"/"no" (হ্যাঁ/না); the dialog still works too
VOICE_CONFIRM=true
# Only your voice gives commands (enroll first: Menu -> Enroll my voice). Voice prints stay on this PC.
SPEAKER_VERIFICATION=false
# 0.1-0.95: higher = stricter
SPEAKER_THRESHOLD=0.45

# --- Memory, documents, faster answers --------------------------------------
# Remember our conversations (on this PC, secrets redacted) and continue after a restart
CONVERSATION_MEMORY=false
# Notice lasting facts you mention ("my thesis is due 15 October") and offer them as memories (Menu -> Memory).
# Nothing is saved until you accept
MEMORY_SUGGESTIONS=true
# When you sound in a hurry or tired (speaking speed and loudness vs your usual), answers get shorter and gentler
TONE_AWARE=true
# Local embedding model for search by meaning (run: ollama pull nomic-embed-text)
EMBEDDING_MODEL=nomic-embed-text
# ;-separated folders for "ask my documents" (e.g. D:\Thesis;C:\Users\me\Documents\Work)
DOCUMENT_FOLDERS=
# Optional small fast model for quick chat and commands; AI_MODEL answers the harder questions
AI_FAST_MODEL=
# Optional bigger model for hard questions (explain, write, compare, plan...), e.g. qwen3:8b. Loading it takes a few
# seconds the first time; everyday requests stay on AI_MODEL
AI_SMART_MODEL=
# Optional coding model for code, errors, tests and builds (e.g. qwen2.5-coder:7b); empty = the smart model, then AI_MODEL
AI_CODING_MODEL=

# --- Desktop -----------------------------------------------------------------
# Sort new files in Downloads into folders by type (Documents, Pictures, Installers ...). Say "undo organize" to undo
AUTO_SORT_DOWNLOADS=false
# Small always-on-top orb in the screen corner while the window is hidden
MINI_ORB=true
# Size of the mini orb in pixels (40-200)
MINI_ORB_SIZE=64
# Opt-in webcam presence: lock the PC when you leave, greet you when you come back (frames are never saved)
PRESENCE_DETECTION=false
PRESENCE_LOCK=true
PRESENCE_AWAY_MINUTES=3
# The first-run setup wizard has been completed (Menu -> Setup wizard to run it again)
SETUP_DONE=false

# --- Extensions and updates ----------------------------------------------------
# Load your own tool plugins from the data folder's "plugins" directory (only code you trust)
PLUGINS_ENABLED=false
# Tools from MCP servers you list in config\mcp.json (see README: MCP). Each asks before it runs
MCP_ENABLED=true
# https URL of your update manifest (JSON with version, url, sha256, notes); empty = no update checks
UPDATE_MANIFEST_URL=
# Only install updates that carry a valid Windows code signature (broken signatures are always refused)
UPDATE_REQUIRE_SIGNATURE=false
# Upgraded automatically; don't change
SETTINGS_VERSION=0

# --- Everyday comfort -----------------------------------------------------------
# "You usually open VS Code around now - shall I open it?" (learned only from apps you open with Jarvis)
PROACTIVE_SUGGESTIONS=true
# Free the AI model's memory after this many idle minutes (it reloads when you say "Jarvis"; 0 = never)
IDLE_UNLOAD_MINUTES=20
# On a GPU with 8 GB or less: a smaller AI context, so the AI model and speech recognition both fit
GPU_MEMORY_SAVER=true
# Ollama started by Jarvis: flash attention and an 8-bit conversation memory (about half its GPU memory)
OLLAMA_FAST_MEMORY=true
# once a week, after 15 minutes without use: a health report (speaks only if something got worse)
WEEKLY_HEALTH_CHECK=true
# HUD motion: panels drawing in, gliding meters, the background scan (false = still)
ANIMATIONS=true
# the cinematic full-screen intro at start, and opening the command center full screen
INTRO_ANIMATION=true
START_FULLSCREEN=true
# keep the Jarvis window above every other window ("stay on top" / "stop staying on top")
ALWAYS_ON_TOP=false
# after opening or searching something, Jarvis fades into the mini orb so you see the app
STEP_ASIDE=true
# songs and YouTube searches reuse the YouTube tab that is already open (no pile of tabs);
# other websites still open in a new tab of the same browser and profile
REUSE_TABS=true
# focus mode ("focus for 45 minutes and close distractions") closes these if they are open
FOCUS_APPS=Steam, Epic Games Launcher, Discord, WhatsApp, Telegram, Messenger
# Phone remote: a private page on your home network (Menu -> Phone remote shows the address + key)
REMOTE_ENABLED=false
REMOTE_PORT=8765
# Also answer phones on your own Tailscale network (away from home). Off by default.
REMOTE_ALLOW_TAILSCALE=false
# Jarvis Wake phone app, waking from another network: your router's public IP or DDNS name, and the UDP port your
# router forwards to this PC (router settings -> port forwarding). Empty = only on the home network.
WAKE_PUBLIC_ADDRESS=
WAKE_PUBLIC_PORT=9
# https for the phone page (needed to talk from the phone and for alerts). The phone warns once about the
# self-signed certificate: Advanced -> Proceed
REMOTE_HTTPS=true

# give the AI the few facts about your projects, goals and unfinished mission that a request needs (local)
WORLD_CONTEXT=true

# Jarvis's own source folder, for the evolution engine ("improve yourself"); empty = automatic when run from source
JARVIS_SOURCE_DIR=

# Proactive intelligence (3.20): off | minimal | normal | active | high
PROACTIVE_LEVEL=normal
# Suggestions are not spoken in quiet hours (they wait in the notification center); empty = none
QUIET_HOURS=23:00-07:00
PROACTIVE_MAX_PER_HOUR=4
# Only these kinds (goal, mission, project, system); empty = all
PROACTIVE_CATEGORIES=
PROACTIVE_EMERGENCY_EXCEPTIONS=true

# --- Changed in the app -----------------------------------------------------
USER_NAME=LABIB
